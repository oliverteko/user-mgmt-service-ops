helm/user-mgmt-service/values-secret.yaml

# Terraform - local state, plugin cache, and any file that might carry the
# DigitalOcean token or other environment-specific values out of tfvars.
# .terraform.lock.hcl is deliberately NOT ignored - that one should be committed
# (pins provider versions/checksums, same idea as a package-lock.json).
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/*.auto.tfvars
terraform/*.auto.tfvars.json
!terraform/terraform.tfvars.example
terraform/crash.log
terraform/crash.*.log
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json
