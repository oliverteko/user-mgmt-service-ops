# Template only - copy to values-secret.yaml and fill in real values.
# values-secret.yaml is gitignored - DO NOT commit real secret values.
#
# Usage:
#   cp values-secret.yaml.example values-secret.yaml
#   helm upgrade --install user-mgmt-service ./helm/user-mgmt-service -f values-secret.yaml

secret:
  # From terraform output (database_user / database_password) - see
  # ../../terraform/database.tf - not a self-chosen username/password anymore.
  dbUsername: user_mgmt_service
  dbPassword: "<real-password>"
  jwtSecret: "<real-jwt-secret>"
